# Opcional: se ficar vazio/omitido, o client.ts deriva o host da API a partir de
# window.location.hostname (funciona em localhost e no telemóvel via IP da rede local).
# Só definir se precisares de apontar para uma API num host diferente do que serve o frontend.
VITE_API_BASE_URL=

# Opcional: Measurement ID do GA4 (formato G-XXXXXXX). Vazio/omitido = sem
# tracking (é o caso em dev - só definido em build-time no docker-compose.prod.yml).
VITE_GA_MEASUREMENT_ID=
